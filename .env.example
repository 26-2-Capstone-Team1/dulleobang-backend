DB_URL=jdbc:postgresql://127.0.0.1:5433/dulleobang_v2
DB_USER=dulleobang
DB_PASSWORD=local-v2-only
PORT=8081
CORS_ORIGINS=http://localhost:3000
# Set three distinct secrets (>=32 characters) in the process environment.
# scripts/run.ps1 creates development-only values under ignored .runtime/.
# .env is NOT automatically loaded by Spring or PowerShell.
JWT_SECRET=
WORKER_JWT_SECRET=
STORAGE_SECRET=

# Public origin used in signed object URLs (HTTPS on a server).
BASE_URL=http://127.0.0.1:8081
# Local object and staging storage. Keep it on persistent storage on a server.
V2_DATA_DIR=.runtime/data
# Optional real social login settings. Empty values return OAUTH_NOT_CONFIGURED.
KAKAO_APP_ID=
GOOGLE_CLIENT_IDS=

# Completed online-furniture imports. Use the same GPU Studio endpoint as the web UI.
SAM3D_ENABLED=false
SAM3D_URL=http://127.0.0.1:18766
