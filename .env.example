# This file is documentation. Set environment variables in the shell or Compose.
APP_ENV=development
DATA_DIR=data
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000

# In production, supply THREE DISTINCT random secrets, each at least 32 characters.
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
# WORKER_JWT_SECRET=
# STORAGE_SECRET=


# Provider app identity; inject in shell/Compose, never commit real credentials.
KAKAO_APP_ID=
GOOGLE_CLIENT_IDS=
